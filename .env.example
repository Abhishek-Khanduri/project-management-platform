# Copy to .env and change the values. Every variable has a safe default for
# local development, so `docker compose up --build` also works without a .env.

# Use a long random value (at least 32 characters); it also signs the JWTs.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=pm
POSTGRES_USER=pm
POSTGRES_PASSWORD=pm

# Token lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

LOG_LEVEL=INFO
